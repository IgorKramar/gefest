reference/

# Сборка
target/

# Окружение. Граница C-2 (ADR-0010): в .env только локальный dev-DSN,
# ничего из матрицы секретов.
.env*

# Ключи и секреты. Git — необратимый канал: коммит уходит на remote и
# остаётся в истории.
*.pem
*.key
*.p12
*.age
secrets/

# Временные файлы sqlx-цикла (сам .sqlx коммитится)
.sqlx/tmp*
